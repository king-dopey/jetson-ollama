# =============================================================================
# ASR Solver Configuration
# =============================================================================
# This file defines the target environment and discovery parameters for the
# ASR dependency stack compatibility solver.
#
# All values can be overridden via environment variables before running run.sh
# =============================================================================

# Target Python version for the ASR stack
TARGET_PYTHON="3.12"

# Target platform (must match Jetson architecture)
TARGET_PLATFORM="linux_aarch64"

# CUDA families to discover and rank (in priority order)
CUDA_FAMILIES="cu132 cu130 cu128"

# Number of top candidates to runtime-probe
TOP_CANDIDATES=3

# Docker images for each CUDA family (runtime, not development)
CUDA_IMAGE_cu132="nvidia/cuda:13.2.0-runtime-ubuntu24.04"
CUDA_IMAGE_cu130="nvidia/cuda:13.0.1-runtime-ubuntu24.04"
CUDA_IMAGE_cu128="nvidia/cuda:12.8.0-runtime-ubuntu24.04"

# PyTorch index URLs for each CUDA family
PYTORCH_INDEX_cu132="https://download.pytorch.org/whl/cu132"
PYTORCH_INDEX_cu130="https://download.pytorch.org/whl/cu130"
PYTORCH_INDEX_cu128="https://download.pytorch.org/whl/cu128"

# Package set to discover and solve
PACKAGE_SET="ctranslate2 faster-whisper torch torchaudio whisperx"

# Maximum versions to consider per package (for performance)
MAX_VERSIONS_PER_PACKAGE=20

# Whether to use cached discovery data (if available)
USE_CACHE=true

# Verbosity level: 0=quiet, 1=normal, 2=verbose
VERBOSE=1
