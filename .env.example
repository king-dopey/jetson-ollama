# Host ports (LAN exposure).
OLLAMA_PORT=11434
ROUTER_PORT=4000
PROFILE=orin

# Ollama global fallback residency for requests that do not set keep_alive.
OLLAMA_KEEP_ALIVE=10m
# Default context length applied to model loads that do not specify num_ctx.
# Warm pipeline models override this per call.
OLLAMA_CONTEXT_LENGTH=16384
# Keep the two always-warm MoE models resident on the 64 GB Orin.
OLLAMA_MAX_LOADED_MODELS=2
# Serialize generation to preserve VRAM headroom for the warm pair plus KV cache.
OLLAMA_NUM_PARALLEL=1
# Enable flash attention for lower memory pressure and better Jetson throughput.
OLLAMA_FLASH_ATTENTION=1
# Use q8_0 KV cache to trade a little memory for better long-context quality.
OLLAMA_KV_CACHE_TYPE=q8_0

# Model IDs expected by LibreChat and router policy.
MODEL_DEFAULT=qwen3.6:35b-a3b
# Models to auto-load at startup with keep_alive=-1 (space-separated, optional @num_ctx suffix).
WARMUP_MODELS=qwen3-coder:30b@65536
# Fallback num_ctx when a WARMUP_MODELS entry omits @num_ctx.
WARMUP_DEFAULT_NUM_CTX=65536

# Router per-model keep_alive defaults (can be overridden per request).
KEEP_ALIVE_DEFAULT=-1

# Proxy-side think policy for Ollama requests.
# Comma-separated tool patterns (case-insensitive) that should force think=false.
DISABLE_THINK_TOOL_PATTERNS=web_search,search,browser,browse,serp,http_get,http,fetch,scrape
# Comma-separated phrases checked in last user message for summary-like requests.
DISABLE_THINK_SUMMARY_PATTERNS=summarize,tl;dr,tldr,bullet summary,key takeaways
# If combined message content length exceeds this threshold, think=false.
DISABLE_THINK_CHAR_THRESHOLD=12000

# Optional Qdrant-backed retrieval inside the router.
ENABLE_QDRANT_RETRIEVAL=false
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=repo_chunks
QDRANT_EMBEDDING_MODEL=qwen3-embedding:4b
QDRANT_TOP_K=20
QDRANT_FINAL_K=8

# Auto-pull configuration for on-demand model pulling
# Set to true to enable auto-pulling of configured models that are not present locally
AUTO_PULL_MISSING_MODELS=false
# Timeout for model pull operations (in seconds)
MODEL_PULL_TIMEOUT_SEC=7200
# Maximum retries for failed pulls
MODEL_PULL_MAX_RETRIES=2
# Backoff time between retries (in seconds)
MODEL_PULL_BACKOFF_SEC=5

# ASR Service Configuration
# Enable the ASR service (default: 1)
ASR_ENABLED=1
# Port for the ASR service (default: 8000)
ASR_PORT=8000
# Default transcription model (default: whisper-large-v3-turbo)
ASR_MODEL=whisper-large-v3-turbo
# Optional accuracy override model (default: whisper-large-v3)
ASR_MODEL_ACCURACY=whisper-large-v3
# Compute type for model inference (default: float16)
ASR_COMPUTE_TYPE=float16
# Target backend: auto, cuda, cpu (default: auto)
ASR_DEVICE=auto
# Jetson deployment expects CUDA-backed ASR and fails fast when unavailable by default
ASR_EXPECT_DEVICE=cuda
# Allow degraded startup on CPU if CUDA is unavailable (default: 0)
ASR_ALLOW_DEGRADED_BACKEND=0
# Allow compute fallback (e.g., float16 -> float32 on CPU) when backend is degraded (default: 0)
ASR_ALLOW_COMPUTE_FALLBACK=0
# Force word-level alignment (default: 1)
ASR_FORCE_ALIGNMENT=1
# Keep ASR service warm (default: 0)
ASR_KEEP_WARM=0
# Build-time Jetson torch wheel source (JetPack 6 / CUDA 12.6 for Orin, JetPack 7 for Thor)
# NOTE: jp6/cu126 currently publishes cp310 torch/torchaudio wheels, so the ASR Dockerfile
# uses a Python 3.10 base image to avoid pulling incompatible/non-Jetson wheels.
ASR_TORCH_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126
ASR_TORCH_VERSION=2.8.0
ASR_TORCHAUDIO_VERSION=2.8.0
# Model cache directory (default: /app/models)
ASR_MODEL_CACHE=/app/models
# Optional overrides; keep within ASR_MODEL_CACHE unless you manage permissions explicitly
HF_HOME=/app/models/hf
HUGGINGFACE_HUB_CACHE=/app/models/hf/hub
TRANSFORMERS_CACHE=/app/models/hf/transformers
XDG_CACHE_HOME=/app/models/xdg
# Log level (default: info)
ASR_LOG_LEVEL=info
