# =============================================================================
# Jetson Ollama Serving Node - Global Environment Configuration
# =============================================================================
#
# PURPOSE:
#   This file defines global environment variables shared across all hardware
#   profiles (Orin, Thor). It is loaded first by Docker Compose's env_file
#   directive, establishing default values that hardware-specific profile files
#   (profiles/orin.env or profiles/thor.env) can override.
#
# LAYERED ENV_FILE ARCHITECTURE:
#   Docker Compose loads environment files in the order specified in
#   docker-compose.yml. Variables defined later override earlier definitions:
#
#     env_file:
#       - profiles/global.env        # Step 1: Global defaults (this file)
#       - profiles/${HARDWARE:-orin}.env  # Step 2: Hardware-specific overrides
#
#   This layered approach separates concerns: global settings (image tags,
#   volume paths, network binding) live here, while hardware-specific tuning
#   (context lengths, parallelism, warmup models) lives in profile files.
#
# USAGE:
#   1. Copy this file to .env in the project root:
#        cp .env.example .env
#   2. Modify values as needed for your deployment.
#   3. Start services with Docker Compose (no --env-file flag needed):
#        HARDWARE=thor docker compose up -d
#
# NOTE: If no .env file exists, Docker Compose falls back to environment
#       variables and default values specified in docker-compose.yml.
# =============================================================================

# -----------------------------------------------------------------------------
# OLLAMA_IMAGE_TAG
# Purpose: Specifies the Docker image tag for the Ollama container.
#
# Valid Options:
#   - ollama/ollama:latest          (default, always latest release)
#   - ollama/ollama:<version>       (pinned version, e.g., "0.5.0")
#   - ollama/ollama@sha256:<digest>  (immutable pin by content hash)
#
# Technical Reasoning:
#   The image tag determines which Ollama binary runs inside the container.
#   Using :latest ensures you get the newest features and bug fixes, but may
#   introduce unexpected changes. For production deployments, pin to a specific
#   version or digest for reproducibility. The image must support arm64 architecture
#   for Jetson devices and include flash attention support for OLLAMA_FLASH_ATTENTION=1.
#
# Integration:
#   Referenced in docker-compose.yml as:
#     image: ${OLLAMA_IMAGE_TAG:-ollama/ollama:latest}
#   Can be overridden by profiles/global.env or the hardware-specific profile file.
# -----------------------------------------------------------------------------
OLLAMA_IMAGE_TAG=ollama/ollama:latest

# -----------------------------------------------------------------------------
# OLLAMA_VOLUME_HOST
# Purpose: Defines the host filesystem path mounted into the container as
#          /root/.ollama, where Ollama stores downloaded models and runtime data.
#
# Valid Options:
#   - /storage/ollama               (default, external storage volume)
#   - /mnt/data/ollama              (alternative mount point)
#   - /path/to/large/disk/ollama    (any path with sufficient space)
#
# Technical Reasoning:
#   LLM models consume significant disk space (10-60 GB per model). The default
#   Orin system drive often lacks sufficient capacity, so an external storage
#   volume is required. Ensure the host path exists and has adequate free space:
#     - qwen3-coder:30b (Q4_K_M)    ~18 GB
#     - qwen3.6:35b-a3b             ~22 GB
#     - qwen3-coder-next:q4_K_M     ~51 GB
#     - qwen3.6:35b-a3b-q8_0        ~38 GB
#   The path must be accessible to the Docker daemon (typically root-owned).
#
# Integration:
#   Referenced in docker-compose.yml as:
#     volumes:
#       - ${OLLAMA_VOLUME_HOST}:/root/.ollama
#   Also loaded via profiles/global.env for env_file-based resolution.
# -----------------------------------------------------------------------------
OLLAMA_VOLUME_HOST=/storage/ollama

# -----------------------------------------------------------------------------
# OLLAMA_HOST
# Purpose: Specifies the network address and port where Ollama binds inside
#          the container and exposes its API service.
#
# Valid Options:
#   - 0.0.0.0:11434                 (default, all interfaces, LAN accessible)
#   - 127.0.0.1:11434               (localhost only, host-only access)
#   - 192.168.1.100:11434           (specific interface IP)
#   - [::]:11434                    (IPv6 all interfaces)
#
# Technical Reasoning:
#   The binding address controls network accessibility:
#     - 0.0.0.0: Allows connections from any network interface (LAN clients,
#       LibreChat instances on other hosts). Required for multi-host deployments.
#     - 127.0.0.1: Restricts access to the host machine only. Use when Ollama
#       is behind a reverse proxy or firewall rules limit external access.
#     - Specific IP: Binds only to a particular network interface. Useful when
#       the device has multiple NICs and you want to isolate the API.
#   Port 11434 is Ollama's default API port and should not be changed unless
#   it conflicts with another service on the host.
#
# Docker Network Binding Best Practices:
#   - For LAN-facing services, use 0.0.0.0:11434 and restrict access via
#     host firewall (iptables/nftables) or router ACLs.
#   - Never expose port 11434 to the public internet without authentication.
#   - The ports directive in docker-compose.yml uses this value directly:
#       - "${OLLAMA_HOST}:11434"
#
# Integration:
#   Referenced in docker-compose.yml ports directive for host-to-container
#   port mapping. Also loaded via profiles/global.env.
# -----------------------------------------------------------------------------
OLLAMA_HOST=0.0.0.0:11434

# -----------------------------------------------------------------------------
# HARDWARE
# Purpose: Selects the hardware-specific profile configuration to load. This
#          variable determines which env_file is loaded second in the layered
#          architecture, overriding global defaults with hardware-tuned settings.
#
# Valid Options:
#   - orin                            (default, Jetson AGX Orin 64 GB)
#   - thor                            (Jetson Thor 128 GB)
#
# Technical Reasoning:
#   Each hardware profile contains settings optimized for its memory capacity
#   and compute capabilities:
#
#     | Setting          | Orin (64 GB)       | Thor (128 GB)      |
#     |------------------|--------------------|--------------------|
#     | OLLAMA_CONTEXT_LENGTH | 65536        | 262144             |
#     | OLLAMA_NUM_PARALLEL   | 1            | 2                  |
#     | WARMUP_MODELS       | qwen3-coder:30b    | qwen3-coder-next:q4_K_M |
#     |                   | + qwen3.6:35b-a3b  | + qwen3.6:35b-a3b-q8_0  |
#
#   The profile file (profiles/${HARDWARE}.env) is loaded after global.env,
#   so its values take precedence. This allows a single docker-compose.yml
#   to support multiple hardware configurations without modification.
#
# Integration:
#   Referenced in docker-compose.yml env_file directive:
#     env_file:
#       - profiles/global.env
#       - profiles/${HARDWARE:-orin}.env
#   The default value "orin" is used when HARDWARE is not set.
# -----------------------------------------------------------------------------
HARDWARE=orin
