# =============================================================================
# Ollama Runtime Configuration
# =============================================================================
# These settings apply to all hardware profiles and are loaded before
# hardware-specific overrides from profiles/jetson/{orin,thor}.env.
# =============================================================================

# Ollama host binding address and port (IP:port format)
# Controls which network interfaces accept API connections
# Valid options: 0.0.0.0:11434 (all interfaces), 127.0.0.1:11434 (localhost only)
# The docker-compose.yml ports directive uses this value directly:
#   - "${OLLAMA_HOST}:11434"
OLLAMA_HOST=0.0.0.0:11434

# Disable Ollama cloud services (required for offline LAN deployment)
# Prevents the container from attempting to connect to Ollama's cloud backend
# Set to 1 to ensure fully air-gapped operation
OLLAMA_NO_CLOUD=1
