# Board profile defaults (Orin 64GB)
MODEL_DEFAULT=qwen3.6:35b-a3b
WARMUP_MODELS=qwen3-coder:30b@65536
WARMUP_DEFAULT_NUM_CTX=65536
MODEL_VERIFY_TAG=qwen3-coder:30b

# ASR build args (Ubuntu 24.04 base — no L4T image required)
ASR_DOCKERFILE=Dockerfile
BASE_IMAGE=ubuntu:24.04
ASR_CUDA_FAMILY=cu132
ASR_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu132
# PyTorch 2.12.0 is the latest stable release; +cu132 suffix is implicit with cu132 index URL
ASR_TORCH_VERSION=2.12.0
ASR_TORCHAUDIO_VERSION=2.12.0
ASR_CTRANSLATE2_VERSION=4.8.0
ASR_CUDA_ARCHITECTURE=87  # Ampere SM 87 for Orin
BUILD_JOBS=$(nproc)
ASR_CUDA_COMPAT_MODE=fallback
ASR_WHISPERX_VERSION=3.8.7rc1
ASR_TORCHVISION_VERSION=0.27.0