# =============================================================================
# Jetson Thor Profile (128 GB Unified Memory)
# =============================================================================
# Hardware-specific settings for the Thor platform. This file is loaded after
# profiles/global.env, so its values override global defaults.
#
# Usage: HARDWARE=thor docker compose up -d
# =============================================================================

# Hardware identifier (used by docker-compose.yml to select profile)
HARDWARE=thor

# =============================================================================
# Ollama Runtime Configuration (Thor 128 GB constraints)
# =============================================================================

# Global fallback residency for requests that do not set keep_alive
OLLAMA_KEEP_ALIVE=10m

# Default context length for model loads without explicit num_ctx
# Warm pipeline models override this per call
OLLAMA_CONTEXT_LENGTH=262144

# Maximum number of models that can be loaded simultaneously
# Set to 2 to allow the documented warm pair to co-reside
OLLAMA_MAX_LOADED_MODELS=2

# Number of parallel generation requests
# Use 2 for higher throughput given larger RAM budget
OLLAMA_NUM_PARALLEL=2

# Enable flash attention for lower memory pressure and better Jetson throughput
OLLAMA_FLASH_ATTENTION=1

# Use q8_0 KV cache to trade a little memory for better long-context quality
OLLAMA_KV_CACHE_TYPE=q8_0

# =============================================================================
# Model Configuration
# =============================================================================

# Default model ID expected by router policy
MODEL_DEFAULT=qwen3.6:35b-a3b-q8_0@262144

# Warmup models to auto-load at startup with keep_alive=-1
# Format: "model@num_ctx model@num_ctx" (space-separated)
WARMUP_MODELS="qwen3-coder-next:q4_K_M@262144 qwen3.6:35b-a3b-q8_0@262144"

# Fallback num_ctx when a WARMUP_MODELS entry omits @num_ctx
WARMUP_DEFAULT_NUM_CTX=262144

# Model to pull with verifier container (first warmup model)
VERIFIER_PULL_MODEL=qwen3-coder-next:q4_K_M
