# =============================================================================
# Warmup Container Configuration
# =============================================================================
# These settings apply to the ollama-warmup service, which preloads models
# after Ollama becomes healthy. Hardware-specific overrides from
# profiles/jetson/{orin,thor}.env may replace WARMUP_MODELS and related vars.
# =============================================================================

# Ollama API URL inside the Docker network (container-to-container)
# The warmup container connects to the ollama service using this URL
OLLAMA_URL=http://ollama:11434

# Models to preload at startup with keep_alive=-1 (space-separated, optional @num_ctx suffix)
# Format: "model@num_ctx model@num_ctx" - entries without @num_ctx fall back to WARMUP_DEFAULT_NUM_CTX
# Hardware-specific profiles override this with their respective warmup models:
#   - Orin:  "qwen3-coder:30b@65536 qwen3.6:35b-a3b@65536"
#   - Thor:  "qwen3-coder-next:q4_K_M@262144 qwen3.6:35b-a3b-q8_0@262144"
WARMUP_MODELS="qwen3-coder-next:q4_K_M@262144 qwen3.6:35b-a3b-q8_0@262144"

# Fallback num_ctx when a WARMUP_MODELS entry omits @num_ctx
# Hardware-specific profiles override this: Orin=65536, Thor=262144
WARMUP_DEFAULT_NUM_CTX = 65536

# KV cache type for warmup operations (q8_0 = higher quality, more memory)
# Must match OLLAMA_KV_CACHE_TYPE in the hardware profile for consistency
KV_CACHE_TYPE = q8_0

# Maximum number of retry attempts per model during pull operation
# The warmup script retries pull+registration checks up to this limit
PULL_MAX_RETRIES = 3

# Base backoff seconds for exponential full-jitter pull retries
# Actual delay = PULL_BACKOFF_SEC * 2^attempt with full jitter applied
PULL_BACKOFF_SEC = 10
