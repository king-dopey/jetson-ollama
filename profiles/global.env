# =============================================================================
# Global Environment Configuration
# =============================================================================
# These variables are shared across all hardware profiles and loaded first
# by Docker Compose's env_file directive.
#
# Hardware-specific settings in jetson/orin.env or jetson/thor.env override
# these values where appropriate.
# =============================================================================

# Docker image tag for Ollama container
OLLAMA_IMAGE_TAG=ollama/ollama:latest

# Host volume path for Ollama data storage (models, runtime data)
OLLAMA_VOLUME_HOST=/storage/ollama

# Ollama host binding (IP:port format for container network interface)
# The ports directive in docker-compose.yml uses this value directly
OLLAMA_HOST=0.0.0.0:11434
