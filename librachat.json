            "RW": false,
            "Source": "/ask/proxy/root_ca.crt",
            "Type": "bind"
          },
          {
            "Destination": "/etc/nginx/nginx.conf",
            "Mode": "ro",
            "Propagation": "rprivate",
            "RW": false,
            "Source": "/ask/proxy/nginx.conf",
            "Type": "bind"
          }
