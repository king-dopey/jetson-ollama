          "443/tcp": [
            {
              "HostIp": "50",
              "HostPort": "443"
            }
          ],
          "80/tcp": [
            {
              "HostIp": "50",
              "HostPort": "80"
            }
          ]
        },
        "networks": {
          "ask_librechat-net": {
            "Aliases": [
              "reverse-proxy",
              "reverse-proxy"
            ],
            "DNSNames": [
              "reverse-proxy",
              "49d1b7c287a1"
            ],
          }
        },
        "mounts": [
          {
            "Destination": "/etc/nginx/ssl/nginx.crt",
            "Mode": "ro",
            "Propagation": "rprivate",
            "RW": false,
            "Source": "/ask/proxy/ask.crt",
            "Type": "bind"
